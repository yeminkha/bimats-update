---
import InnerLayout from "../../layouts/InnerLayout.astro";
import Carousel from "../../components/Carousel.astro";
import Contact from "../../components/Contact.astro";
import Connect from "../../components/Connect.astro";
---

<InnerLayout>
  <section class="home service-details-home">
    <div class="container">
      <h1>Consulting Services</h1>
      <p>
        Home / <a href="/service">Service</a>
      </p>
    </div>
  </section>
  <Carousel />
  <section class="sub-section">
    <div class="container">
      <!-- <div class="video-container">
        <video autoplay muted loop playsinline poster="/images/thumbnail.jpg">
          <source src="/videos/service.mp4" type="video/mp4" />
          Your browser does not support the HTML video tag.
        </video>
      </div> -->
      <div class="bg-icon">
        <img src="/images/icons/team.png" alt="" />
      </div>
      <h1>
        About <span>Consulting Services</span>
      </h1>

      <p>
        We offer IT consulting services that will help you improve your IT
        infrastructure, create a tech-driven digital strategy, and improve
        operations by optimizing your infrastructure. Our engineers will finish
        your digital transformation journey through careful planning and
        effective execution of the outlined IT strategy.
      </p>
      <p>
        Our IT experts have worked in the industries for over fifteen years.
        This has allowed us to craft an effective approach to IT consulting that
        enables us to deliver maximum benefit in the shortest time.
      </p>
    </div>
  </section>
  <!-- <Carousel /> -->
  <Contact />
  <Carousel />
  <Connect />
</InnerLayout>
