---
import Layout from "../layouts/Layout.astro";

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<Layout>
  <header>
    <nav>
  <a class="logo"><img src="/images/icons/logo-trans.png" alt=""></a>
  <div class="links" id="nav-links">
      <div class="item has-drop">
    <a href="/">IT SERVICE</a>
        <div class="dropdown dropdown1">
            <a
              href="/services/it-outsourcing"
              class:list={{
                active: currentPath.endsWith("/it-outsourcing"),
              }}>IT Outsourcing</a
            >
            <a
              href="/services/manage-it-services"
              class:list={{
                active: currentPath.endsWith("/manage-it-services"),
              }}>Manage IT Service</a
            >

            <a
              href="/services/it-infra-management"
              class:list={{
                active: currentPath.endsWith("/it-infra-management"),
              }}>IT Infra Management</a
            >
            <a
              href="/services/it-service-management-and-governance"
              class:list={{
                active: currentPath.endsWith(
                  "/it-service-management-and-governance",
                ),
              }}>IT Service Management & Governance</a
            >
            <a
              href="/services/consulting-services"
              class:list={{
                active: currentPath.endsWith("/consulting-services"),
              }}>Consulting Services</a
            >
            <a
              href="/services/professional-services"
              class:list={{
                active: currentPath.endsWith("/professional-services"),
              }}>Professional Services</a
            >
            <a
              href="/services/end-user-it-services"
              class:list={{
                active: currentPath.endsWith("/end-user-it-services"),
              }}>End User IT Services</a
            >
            <a
              href="/services/hardware-software-maintenance"
              class:list={{
                active: currentPath.endsWith("/hardware-software-maintenance"),
              }}>Hardware/Software Maintenance</a
            >
            <a
              href="/services/regional-coverage"
              class:list={{
                active: currentPath.endsWith("/regional-coverage"),
              }}>Regional Coverage</a
            >
            <a
              href="/services/cloud-integrating-service"
              class:list={{
                active: currentPath.endsWith("/cloud-integrating-service"),
              }}>Cloud Integrating Service</a
            >
            <a
              href="/services/cyber-security"
              class:list={{
                active: currentPath.endsWith("/cyber-security"),
              }}>Cyber Security</a
            >
            <a
              href="/services/maintenance-support-services"
              class:list={{
                active: currentPath.endsWith("/maintenance-support-services"),
              }}>Maintenance Support Services</a
            >
        </div>
  </div>

  <div class="item has-drop">
    <a href="/service">SOLUTIONS</a>
        <div class="dropdown dropdown2">
            <a
              href="/solutions/virtual-desktop-infrastructure"
              class:list={{
                active: currentPath.endsWith("/virtual-desktop-infrastructure"),
              }}>Virtual Desktop Infrastructure</a
            >
            <a
              href="/solutions/voice-over-ip"
              class:list={{
                active: currentPath.endsWith("/voice-over-ip"),
              }}>Voice Over IP</a
            >
            <a
              href="/solutions/video-conferencing"
              class:list={{
                active: currentPath.endsWith("/video-conferencing"),
              }}>Video Conferencing</a
            >
            <a
              href="/solutions/cabling-services"
              class:list={{
                active: currentPath.endsWith("/cabling-services"),
              }}>Cabling Services</a
            >
            <a
              href="/solutions/storage-solutions"
              class:list={{
                active: currentPath.endsWith("/storage-solutions"),
              }}>Storage Solutions</a
            >
            <a
              href="/solutions/collaboration-solutions"
              class:list={{
                active: currentPath.endsWith("/collaboration-solutions"),
              }}>Collaboration Solutions</a
            >
            <a
              href="/solutions/software-licensing"
              class:list={{
                active: currentPath.endsWith("/software-licensing"),
              }}>Software Licensing</a
            >
            <a
              href="/solutions/products"
              class:list={{
                active: currentPath.endsWith("/products"),
              }}>Products</a
            >
        </div>
  </div>

  <div class="item"><a href="/#projects">PARTNERS</a></div>

  <div class="item has-drop">
    <a href="/#about">ABOUT US</a>
    <div class="dropdown dropdown4">
      <a href="/about">Who We Are</a><a href="/policy">Policy</a>
    </div>
  </div>
    <a href="/#contact" class="mobile-only btn-solid">Contact us</a>
  </div>
  <a href="/#contact" class="contact-me btn-solid">Contact us</a>

  <button class="menu-toggle" aria-label="Toggle menu" aria-expanded="false" aria-controls="nav-links">
    <span></span><span></span><span></span>
  </button>
</nav>
  </header>
  <main>
    <slot/>
  </main>
  
  <footer> 
    <div class="container">
      BIM Advanced Technology Services. All Rights Reserved © 2019
    </div>
  </footer>
</Layout>

